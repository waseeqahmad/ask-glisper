# Copy to .env (gitignored). SAMPLE_MODE=true needs none of these.
SAMPLE_MODE=false
# Meterless Nightshift > Console > API key. NVIDIA's key lives in Nightshift's Providers tab, not here.
NIGHTSHIFT_API_KEY=paste-from-nightshift-console
# NIGHTSHIFT_URL=http://127.0.0.1:8088/v1
# NIGHTSHIFT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NIGHTSHIFT_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Postgres holding the demo audit (loaded by scripts/make_demo_data.py, registered in Zetaris)
GLISPER_DEMO_DB_URL=postgresql://user:password@localhost:5433/ask_glisper_demo
# Glisper mode: a read-only role that sees only the ask_glisper views (scripts/glisper_views.sql), registered in
# Zetaris as GLISPER (python3 scripts/register_zetaris.py GLISPER_DB_URL GLISPER)
GLISPER_DB_URL=postgresql://ask_glisper_ro:password@localhost:5433/glimpser
# GLISPER_CATALOG=GLISPER
# Zetaris: ZETARIS_ADMIN_PASSWORD is read from zetaris-platform/.env
# ZETARIS_URL=http://localhost:3001
# ZETARIS_CATALOG=GLISPER_DEMO
# Only for scripts/capture_web_search.py (optional, free tier)
GROQ_API_KEY=
